<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<BorderPane prefHeight="600.0"
            prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ScrumLords.TicketSelectionController">

    <top>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <Label fx:id="movieTitleLabel"
                   text="Movie Ticket Selection"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label fx:id="showtimeLabel"
                   text="Showtime: 7:00 PM"
                   style="-fx-font-size: 14px;"/>

            <Label text="Select the seats you want."/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>

            <Label text="SCREEN"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Region prefHeight="8.0"
                    prefWidth="350.0"
                    maxHeight="8.0"
                    maxWidth="350.0"
                    style="-fx-background-color: lightgray; -fx-background-radius: 4;"/>

            <GridPane fx:id="seatGrid"
                      alignment="CENTER"
                      hgap="8.0"
                      vgap="8.0"
                      maxWidth="-Infinity"
                      maxHeight="-Infinity"/>

            <HBox alignment="CENTER" spacing="25.0">
                <Label text="● Available"
                       style="-fx-text-fill: #4A90E2; -fx-font-weight: bold;"/>

                <Label text="● Selected"
                       style="-fx-text-fill: #E74C3C; -fx-font-weight: bold;"/>

                <Label text="● Taken"
                       style="-fx-text-fill: #808080; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <BorderPane>
            <padding>
                <Insets top="15.0" right="50.0" bottom="25.0" left="50.0"/>
            </padding>

            <left>
                <Button text="Back"
                        onAction="#handleBack"/>
            </left>

            <center>
                <VBox alignment="CENTER" spacing="5.0">
                    <Label fx:id="selectedSeatsLabel"
                           text="Selected seats: None"/>

                    <Label fx:id="totalPriceLabel"
                           text="Total: $0.00"
                           style="-fx-font-weight: bold;"/>
                </VBox>
            </center>

            <right>
                <Button fx:id="confirmButton"
                        text="Confirm"
                        onAction="#handleConfirm"
                        disable="true"/>
            </right>
        </BorderPane>
    </bottom>

</BorderPane>