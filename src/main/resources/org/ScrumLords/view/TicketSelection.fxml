<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21.0.3-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ScrumLords.controller.TicketSelectionController">

    <top>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label fx:id="movieTitleLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Movie Ticket Selection" />

            <Label fx:id="showtimeLabel" style="-fx-font-size: 14px;" text="Showtime: 7:00 PM" />

            <Label text="Select the seats you want." />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="SCREEN" />

            <Region maxHeight="8.0" maxWidth="350.0" prefHeight="8.0" prefWidth="350.0" style="-fx-background-color: lightgray; -fx-background-radius: 4;" />

            <GridPane fx:id="seatGrid" alignment="CENTER" hgap="8.0" maxHeight="-Infinity" maxWidth="-Infinity" vgap="8.0" />

            <HBox alignment="CENTER" spacing="25.0">
                <Label style="-fx-text-fill: #4A90E2; -fx-font-weight: bold;" text="● Available" />

                <Label style="-fx-text-fill: #E74C3C; -fx-font-weight: bold;" text="● Selected" />

                <Label style="-fx-text-fill: #808080; -fx-font-weight: bold;" text="● Taken" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <BorderPane>
            <padding>
                <Insets bottom="25.0" left="50.0" right="50.0" top="15.0" />
            </padding>

            <left>
                <Button onAction="#goBack" text="Back" />
            </left>

            <center>
                <VBox alignment="CENTER" spacing="5.0">
                    <Label fx:id="selectedSeatsLabel" text="Selected seats: None" />

                    <Label fx:id="totalPriceLabel" style="-fx-font-weight: bold;" text="Total: $0.00" />
                </VBox>
            </center>

            <right>
                <Button fx:id="confirmButton" disable="true" onAction="#handleConfirm" text="Confirm" />
            </right>
        </BorderPane>
    </bottom>

</BorderPane>
